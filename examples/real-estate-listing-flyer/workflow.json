						{
							"id": "cfg-0002",
							"name": "drive_folder_id",
							"value": "YOUR_DRIVE_FOLDER_ID",
							"type": "string"
						},
						{
							"id": "cfg-0003",
							"name": "spreadsheet_id",
							"value": "={{ ($('On Sheet row update').params.documentId.value || '').toString().match(/[-\\w]{25,}/)?.[0] }}",
							"type": "string"
						},
						{
							"id": "cfg-0004",
							"name": "sheet_id",
							"value": "={{ $('On Sheet row update').params.sheetName.value }}",
							"type": "string"
