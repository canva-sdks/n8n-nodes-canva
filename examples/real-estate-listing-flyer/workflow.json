			"typeVersion": 3,
			"position": [1776, 672],
			"alwaysOutputData": true
		},
		{
			"parameters": {
				"resource": "autofill",
				"brandTemplateId": "={{ $('Workflow configuration').item.json.brand_template_id }}",
				"data": "={{ JSON.stringify({\n  property_photo: { type: 'image', asset_id: $json.job.asset.id },\n  address: { type: 'text', text: $('Workflow configuration').item.json.address },\n  price: { type: 'text', text: $('Workflow configuration').item.json.price.toString() },\n  beds_baths: { type: 'text', text: $('Workflow configuration').item.json.beds + ' bed · ' + $('Workflow configuration').item.json.baths + ' bath' },\n  agent_name: { type: 'text', text: $('Workflow configuration').item.json.agent_name },\n  agent_phone: { type: 'text', text: $('Workflow configuration').item.json.agent_phone.toString() }\n}) }}",
				"title": "={{ 'Listing flyer — ' + $('Workflow configuration').item.json.listing_id + ' ' + $('Workflow configuration').item.json.address }}"
			},
			"id": "d0ac976a-049b-4cc9-b75e-3628dff8a28d",
			"name": "Create design from brand template",
			"type": "@canva/n8n-nodes-canva.canva",
